# Poker Tracker — variables du projet.
#
# Modèle suivi par git. La vraie configuration se nomme .env, vit uniquement
# sur le NAS à côté du docker-compose.yml, et n'est jamais commitée : elle est
# ignorée par .gitignore, de sorte qu'un « git pull » ne l'écrase pas et qu'un
# « git push » ne la publie pas.
#
#   cp env.example .env     puis renseigner les valeurs, une fois pour toutes
#
# ⚠ Les trois valeurs POSTGRES_* doivent être IDENTIQUES à celles du
# déploiement en cours : la base existe déjà dans pgdata, avec son utilisateur
# et son mot de passe. Les changer ne recrée rien, ça casse la connexion.
# Pour les relire depuis le conteneur qui tourne :
#   sudo docker inspect winamax-watcher --format '{{range .Config.Env}}{{println .}}{{end}}'
# la ligne DB_URL a la forme postgresql://UTILISATEUR:MOTDEPASSE@postgres:5432/BASE

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Emplacement des données PostgreSQL. Le défaut, ./pgdata, place la base dans
# le dossier du projet : pratique, mais si ce dossier est un clone git, la base
# se retrouve dans l'arborescence de travail. Un chemin absolu hors du dépôt la
# met à l'abri des manipulations git.
#   PGDATA_DIR=/volume1/docker/winamax-data/pgdata
# Changer ce chemin ne déplace rien : il faut copier pgdata soi-même, conteneurs
# arrêtés, avec « cp -a » pour conserver propriétaire et permissions.
PGDATA_DIR=./pgdata

# ── Import ────────────────────────────────────────────────────────────────────
# Dossier des fichiers Winamax, monté en lecture seule. Chemin absolu du NAS.
# Un alias /home/... ne fonctionne pas : le démon Docker, qui tourne en root,
# ne le résout pas. Il faut le chemin réel sous /volume1.
WATCH_DIR=/volume1/homes/UTILISATEUR/Drive/Backup

# Pseudo Winamax. Laisser vide pour le détecter automatiquement — nécessaire
# si la sauvegarde contient plusieurs comptes, sinon les mains de l'autre
# compte seraient ignorées.
WINAMAX_PSEUDO=

# ── Classeurs de session ──────────────────────────────────────────────────────
# Dossier qui reçoit les .xlsx. Doit exister avant le premier démarrage,
# et être accessible en écriture.
EXPORT_DIR=/volume1/homes/UTILISATEUR/Drive/Poker/sessions
# Minutes sans une seule main qui séparent deux sessions.
SESSION_GAP_MINUTES=45

# Ancienneté maximale d'une session exportée automatiquement, en jours.
# Évite qu'un premier démarrage déverse tout l'historique d'un coup.
EXPORT_LOOKBACK_DAYS=7

# Délai au-delà duquel une session est écrite même s'il manque un résumé
# de tournoi (le classeur est alors régénéré quand le résumé arrive).
EXPORT_GRACE_HOURS=6

# Fréquence de vérification des sessions terminées, en secondes.
EXPORT_CHECK_SECONDS=300

# ── Bankroll ──────────────────────────────────────────────────────────────────
# Le fichier .ods tenu à jour à chaque fin de session : une ligne par session,
# ajoutée à la suite des tiennes. Laisser vide pour prendre
# EXPORT_DIR/bankroll_poker_mtt.ods. Le fichier n'est jamais créé : s'il n'est
# pas là, le watcher le dit au démarrage et n'y touche pas.
BANKROLL_FILE=

# Le dossier qui contient ce fichier, monté en écriture dans le conteneur. À
# renseigner uniquement si le .ods n'est pas rangé dans EXPORT_DIR : le
# conteneur ne voit que ce qui est monté, et un fichier situé ailleurs sur le
# NAS lui reste invisible, même avec le bon chemin dans BANKROLL_FILE.
# Toujours le dossier, jamais le fichier lui-même.
BANKROLL_DIR=

# Le compte suivi par ce fichier. Si la sauvegarde en contient plusieurs, sans
# ce réglage ils seraient additionnés dans la même bankroll.
BANKROLL_PLAYER=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=
GRAFANA_PASSWORD=
